# Api: internal service, proxies to the backend on the private network.
resolver 127.0.0.11 valid=5s;
error_log /dev/stderr warn;

server {
    listen 8080;
    server_name _;

    proxy_connect_timeout 2s;
    proxy_read_timeout    3s;

    location /healthz { return 200 "api ok\n"; }

    location / {
        set $upstream http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass $upstream;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Hop-2 api;
    }
}
