# Edge: public entrypoint, proxies everything to the internal api.
# resolver + variable in proxy_pass: the name is resolved per request,
# so nginx starts even if the upstream does not exist yet.
resolver 127.0.0.11 valid=5s;
error_log /dev/stderr warn;

server {
    listen 80;
    server_name _;

    proxy_connect_timeout 2s;
    proxy_read_timeout    3s;

    location /healthz { return 200 "edge ok\n"; }

    location / {
        set $upstream http://${API_HOST}:${API_PORT};
        proxy_pass $upstream;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Hop-1 edge;
    }
}
